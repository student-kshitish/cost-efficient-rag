APP_NAME=Cost-Efficient RAG
APP_ENV=development
LOG_LEVEL=INFO

VECTOR_DB_PATH=./data/lancedb
DOCUMENT_DIR=./data/documents

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHUNK_SIZE=500
CHUNK_OVERLAP=100

TOP_K=5

LLM_PROVIDER=ollama
